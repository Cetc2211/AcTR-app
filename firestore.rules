
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return isSignedIn() && request.auth.token.email is string
        ? request.auth.token.email
        : '';
    }

    function isMasterAdmin() {
      return userEmail() == 'mpceciliotopetecruz@gmail.com';
    }

    function isConfiguredAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(userEmail()));
    }

    function isAdmin() {
      return isMasterAdmin() || isConfiguredAdmin();
    }

    function isPublicSessionReadable() {
      return resource.data.public == true &&
        resource.data.status in ['pending', 'open', 'active'];
    }

    function hasOnlyResultFields() {
      return request.resource.data.keys().hasOnly([
        'sessionId',
        'studentId',
        'testId',
        'pruebaNombre',
        'resultado',
        'answers',
        'createdAt',
        'updatedAt',
        'source',
        'grupoId',
        'metadata'
      ]);
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /absences/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /tracking_logs/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /official_groups/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /students/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /announcements/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /justifications/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /observations/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /academic_compliance/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /app_config/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /admins/{email} {
      allow read: if isSignedIn();
      allow write: if (!isSignedIn() && email == 'mpceciliotopetecruz@gmail.com') || isAdmin();
    }

    match /evaluation_sessions/{sessionId} {
      allow read: if isSignedIn() || isPublicSessionReadable();
      allow create: if isSignedIn() || isAdmin();
      allow update: if isSignedIn() || (
        isPublicSessionReadable() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'startedAt',
          'completedAt',
          'updatedAt',
          'lastAccessedAt',
          'responseId'
        ])
      );
      allow delete: if isAdmin();
    }

    match /test_results/{resultId} {
      allow create: if hasOnlyResultFields() &&
        exists(/databases/$(database)/documents/evaluation_sessions/$(request.resource.data.sessionId));
      allow read: if isSignedIn() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /alumnos/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
